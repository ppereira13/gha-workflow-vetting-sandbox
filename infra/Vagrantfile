# Disposable VM that runs the static analysis inside a Docker container.
Vagrant.configure("2") do |config|
  # Local Ubuntu 24.04 box. Replace with a public Ubuntu 24.04 box to reproduce.
  config.vm.box = "local-ubuntu-24.04"
  config.vm.hostname = "vetting-sandbox"

  # The repository is mounted read-only, so nothing in the VM can change it.
  config.vm.synced_folder "..", "/workspace", mount_options: ["ro"]
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "virtualbox" do |vb|
    vb.name = "gha-vetting-sandbox"
    vb.memory = 2048
    vb.cpus = 1
  end

  # Ansible runs inside the VM, so the host does not need it installed.
  config.vm.provision "ansible_local" do |ansible|
    ansible.provisioning_path = "/workspace/infra"
    ansible.playbook = "playbook.yml"
  end
end